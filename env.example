# Application
PROJECT_NAME="The Reform School for Witches - Reader Portal"
APP_ENV=staging
DEBUG=False
PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production
SITE_URL=https://staging.rsfwseries.com

# Security & Cookie Flags
COOKIE_SECURE=True
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=lax

# Manuscript Path
MANUSCRIPT_PATH=app/static/downloads/RSFW_Book_1_The_Blood_Lily_Contract.pdf

# Supabase (Optional)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Brevo (Email Gateway)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=hello@redcandledigital.io
BREVO_SENDER_NAME="Our Lady of Tears Academy"